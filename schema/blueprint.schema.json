{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gitfactory.dev/schema/blueprint.schema.json",
  "title": "GitFactory Blueprint",
  "type": "object",
  "required": ["version", "meta", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "owner/name of the target repository"
        },
        "description": { "type": "string", "maxLength": 2000 },
        "pinActions": { "type": "boolean", "description": "SHA-pinned actions mode: emit uses: refs pinned to verified commit SHAs (ADR-026)" },
        "lineNaming": { "type": "string", "enum": ["auto", "indexed"], "description": "Per-line naming for multi-line blueprints: 'auto' derives names from each line's agent promptRef or trigger+sink (ADR-028); default is '<name> <index>'" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "position", "config"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "type": {
            "type": "string",
            "description": "Machine type id from the registry",
            "enum": [
              "trigger.issue_opened",
              "trigger.issue_labeled",
              "trigger.pr_opened",
              "trigger.comment",
              "trigger.cron",
              "trigger.manual",
              "trigger.workflow_run",
              "trigger.repository_dispatch",
              "agent.claude",
              "filter.condition",
              "processor.dependabot_meta",
              "processor.feedback_controller",
              "gate.approval",
              "gate.enablement",
              "rate.limiter",
              "processor.ledger",
              "gate.budget",
              "processor.evidence",
              "gate.verified_fix",
              "sink.comment",
              "sink.label",
              "sink.create_issue",
              "sink.open_pr",
              "sink.commit_files",
              "sink.merge_pr",
              "sink.cross_repo_issue",
              "sink.repository_dispatch"
            ]
          },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "config": { "type": "object" }
        },
        "$comment": "Per-machine-type config subschemas. Property names/JSON types mirror app/src/machines/registry.ts fields (kind number → number, text/textarea/select → string); drift-guarded by app/src/machines/schema.test.ts. No keys are required (configs may omit fields and fall back to registry defaults), but unknown keys are rejected.",
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "trigger.issue_opened" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": {} } } }
          },
          {
            "if": { "properties": { "type": { "const": "trigger.issue_labeled" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "trigger.pr_opened" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "fireOn": { "type": "string" }, "alsoOnSync": { "type": "string" }, "label": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "trigger.comment" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "phrase": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "trigger.cron" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "cron": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "trigger.manual" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "mode": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "trigger.workflow_run" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "workflow": { "type": "string" }, "conclusion": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.repository_dispatch" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "targetRepo": { "type": "string" }, "eventType": { "type": "string" }, "tokenSecret": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "trigger.repository_dispatch" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "eventType": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "agent.claude" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "promptRef": { "type": "string" }, "model": { "type": "string" }, "maxTurns": { "type": "number" }, "checks": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "filter.condition" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "expression": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "processor.dependabot_meta" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "allow": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "processor.feedback_controller" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "promptRef": { "type": "string" }, "model": { "type": "string" }, "ledgerPath": { "type": "string" }, "windowDays": { "type": "number" }, "maxTurns": { "type": "number" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "gate.approval" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "environment": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "gate.enablement" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "variable": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "rate.limiter" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "maxPerDay": { "type": "number" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "processor.ledger" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "ledgerPath": { "type": "string" }, "selectCmd": { "type": "string" }, "updateCmd": { "type": "string" }, "reportBranch": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "gate.budget" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "maxOpenPrs": { "type": "number" }, "maxItemsPerRun": { "type": "number" }, "skipWithinDays": { "type": "number" }, "prLabel": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "processor.evidence" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "measureCmd": { "type": "string" }, "evidencePath": { "type": "string" }, "artifactName": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "gate.verified_fix" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "verifyCmd": { "type": "string" }, "onFail": { "type": "string" }, "maxRounds": { "type": "number" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.comment" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "instruction": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.label" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "labels": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.create_issue" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "titleHint": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.open_pr" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "branchHint": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.commit_files" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "pathScope": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.merge_pr" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "method": { "type": "string" }, "when": { "type": "string" } } } } }
          },
          {
            "if": { "properties": { "type": { "const": "sink.cross_repo_issue" } }, "required": ["type"] },
            "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": { "targetRepo": { "type": "string" }, "tokenSecret": { "type": "string" }, "titleHint": { "type": "string" } } } } }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "from": { "$ref": "#/definitions/port" },
          "to": { "$ref": "#/definitions/port" }
        }
      }
    }
  },
  "definitions": {
    "port": {
      "type": "object",
      "required": ["node", "port"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "port": { "type": "string", "description": "'out' | 'in' in v0; reserved for typed belt-mode ports" }
      }
    }
  }
}
