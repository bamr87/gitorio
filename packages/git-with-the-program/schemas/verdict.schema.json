{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gwtp/verdict.schema.json",
  "title": "GWTP Judge Verdict (judge output contract, pre-ledger)",
  "type": "object",
  "required": ["assertion", "verdict"],
  "properties": {
    "assertion": { "type": "string" },
    "verdict": { "enum": ["aligned", "drift", "regression", "stale-claim", "abstain"] },
    "severity": { "enum": ["grazes", "bends", "breach", "entrenches"], "description": "Anchored ordinal; engine maps to 0.25/0.5/0.75/1.0" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string", "pattern": "^.+:[0-9]+(-[0-9]+)?$" }, "description": "file:line-span citations. Mandatory for violations: no citation, no verdict." },
    "precedent": { "type": ["string", "null"], "description": "PRE-id; required when verdict = regression" },
    "rationale": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "enum": ["drift", "regression", "stale-claim"] } } },
      "then": { "required": ["severity", "evidence", "rationale"] }
    },
    {
      "if": { "properties": { "verdict": { "const": "regression" } } },
      "then": { "required": ["precedent"] }
    }
  ]
}
