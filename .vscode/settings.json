// gitorio · .vscode/settings.json — fleet-vscode/v1 · 2026-09-09. Convention + vocabulary: .vscode/README.md.
// Repo-scoped settings only. Personal editor preferences belong in the fleet workspace file.
{
  "files.exclude": {
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/out": true
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  "cSpell.words": [
    "bamr",
    "zer0",
    "endcapture",
    "endraw",
    "frontmatter",
    "Jamstack",
    "lastmod",
    "livereload",
    "markdownify",
    "wikilinks",
    "rubygems",
    "gemspec",
    "webrick",
    "posthog"
  ],
  "eslint.workingDirectories": [
    "app"
  ]
}
