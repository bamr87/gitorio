        "x": 340,
        "y": 140
      },
      "config": {
        "promptRef": ".factory/prompts/triage.md",
        "model": "claude-sonnet-4-6",
        "maxTurns": 16
      }
    },
    {
      "id": "s1",
      "type": "sink.label",
      "position": {
        "x": 660,
        "y": 60
      },
      "config": {
        "labels": ""
      }
    },
    {
      "id": "s2",
      "type": "sink.comment",
      "position": {
        "x": 660,
        "y": 220
      },
      "config": {
        "instruction": "summarizes the triage decision in 3 lines and links any duplicates"
      }
    },
    {
      "id": "t2",
      "type": "trigger.cron",
      "position": {
        "x": 40,
        "y": 420
      },
      "config": {
        "cron": "0 3 * * *"
      }
    },
    {
      "id": "a2",
      "type": "agent.claude",
      "position": {
        "x": 340,
        "y": 420
      },
