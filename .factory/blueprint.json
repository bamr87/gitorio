{
  "version": 1,
  "meta": {
    "name": "Gitorio Factory",
    "repo": "bamr87/gitorio",
    "description": "Issue triage + nightly gardener + a dependency warden that reviews the open Dependabot PRs on a manual lever and weekly."
  },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger.issue_opened",
      "position": {
        "x": 40,
        "y": 140
      },
      "config": {}
    },
