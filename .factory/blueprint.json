    },
    {
      "id": "s3",
      "type": "sink.comment",
      "position": {
        "x": 660,
        "y": 420
      },
      "config": {
        "instruction": "posts a gentle stale-issue nudge on each issue inactive for 30+ days (max 5 per night)"
      }
    },
    {
      "id": "wm",
      "type": "trigger.manual",
      "position": {
        "x": 40,
        "y": 660
      },
      "config": {}
