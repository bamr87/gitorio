{
  "version": 1,
  "meta": {
    "name": "Gitorio Factory",
    "repo": "bamr87/gitorio",
    "description": "Issue triage + nightly gardener + a dependency warden that reviews and labels the open Dependabot PRs (it never merges) + a human-label-gated deterministic merge line. The scheduled lines are default-OFF behind kill switches."
  },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger.issue_opened",
      "position": {
        "x": 40,
        "y": 140
      },
      "config": {}
    },
    {
      "id": "a1",
      "type": "agent.claude",
      "position": {
        "x": 340,
        "y": 140
      },
      "config": {
        "promptRef": ".factory/prompts/triage.md",
        "model": "claude-sonnet-4-6",
        "maxTurns": 8
      }
    },
    {
      "id": "s1",
      "type": "sink.label",
      "position": {
        "x": 660,
        "y": 60
      },
      "config": {
        "labels": ""
      }
    },
    {
      "id": "s2",
      "type": "sink.comment",
      "position": {
        "x": 660,
        "y": 220
      },
      "config": {
        "instruction": "summarizes the triage decision in 3 lines and links any duplicates"
      }
    },
    {
      "id": "t2",
      "type": "trigger.cron",
      "position": {
        "x": 40,
        "y": 420
      },
      "config": {
        "cron": "17 3 * * *"
      }
    },
    {
      "id": "g2",
      "type": "gate.enablement",
      "position": {
        "x": 250,
        "y": 420
      },
      "config": {
        "variable": "NIGHTLY_GARDENER_ENABLED"
      }
    },
    {
      "id": "r2",
      "type": "rate.limiter",
      "position": {
        "x": 440,
        "y": 420
      },
      "config": {
        "maxPerDay": 2
      }
    },
    {
      "id": "a2",
      "type": "agent.claude",
      "position": {
        "x": 630,
        "y": 420
      },
      "config": {
        "promptRef": ".factory/prompts/nightly-gardener.md",
        "model": "claude-sonnet-4-6",
        "maxTurns": 24
      }
    },
    {
      "id": "s3",
      "type": "sink.comment",
      "position": {
        "x": 870,
        "y": 420
      },
      "config": {
        "instruction": "posts a gentle stale-issue nudge on each issue inactive for 30+ days (max 5 per night)"
      }
    },
    {
      "id": "wm",
      "type": "trigger.manual",
      "position": {
        "x": 40,
        "y": 660
      },
      "config": {}
    },
    {
      "id": "wc",
      "type": "trigger.cron",
      "position": {
        "x": 40,
        "y": 800
      },
      "config": {
        "cron": "23 6 * * 1"
      }
    },
    {
      "id": "wg",
      "type": "gate.enablement",
      "position": {
        "x": 250,
        "y": 730
      },
      "config": {
        "variable": "DEPENDENCY_WARDEN_ENABLED"
      }
    },
    {
      "id": "wr",
      "type": "rate.limiter",
      "position": {
        "x": 440,
        "y": 730
      },
      "config": {
        "maxPerDay": 3
      }
    },
    {
      "id": "wa",
      "type": "agent.claude",
      "position": {
        "x": 630,
        "y": 720
      },
      "config": {
        "promptRef": ".factory/prompts/dependency-warden.md",
        "model": "claude-sonnet-4-6",
        "maxTurns": 25
      }
    },
    {
      "id": "ws1",
      "type": "sink.comment",
      "position": {
        "x": 870,
        "y": 640
      },
      "config": {
        "instruction": "records the dependency's merge-risk verdict — bump size, breaking-change check, and a merge recommendation — in ~4 lines"
      }
    },
    {
      "id": "ws2",
      "type": "sink.label",
      "position": {
        "x": 870,
        "y": 800
      },
      "config": {
        "labels": ""
      }
    },
    {
      "id": "mt",
      "type": "trigger.pr_opened",
      "position": {
        "x": 40,
        "y": 1000
      },
      "config": {
        "fireOn": "labeled",
        "label": "dep:merge-approved"
      }
    },
    {
      "id": "mg",
      "type": "gate.enablement",
      "position": {
        "x": 250,
        "y": 1000
      },
      "config": {
        "variable": "DEPENDENCY_MERGE_ENABLED"
      }
    },
    {
      "id": "mf",
      "type": "filter.condition",
      "position": {
        "x": 440,
        "y": 1000
      },
      "config": {
        "expression": "github.event.sender.type != 'Bot' && github.event.pull_request.user.login == 'dependabot[bot]'"
      }
    },
    {
      "id": "mm",
      "type": "sink.merge_pr",
      "position": {
        "x": 660,
        "y": 1000
      },
      "config": {
        "method": "squash",
        "when": "auto"
      }
    }
  ],
